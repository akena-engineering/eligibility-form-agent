{
  "name": "eligibility-form-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "dev:api": "pnpm --filter @efa/api dev",
    "dev": "pnpm --parallel --filter @efa/api --filter @efa/web dev"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
